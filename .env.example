# API (apps/api)
DATABASE_URL=postgres://mtb:mtb@localhost:5432/mtb_deals?sslmode=disable
SCRAPER_SERVICE_URL=http://localhost:3000
# Same random string on API and scraper when the scraper is network-reachable (sets X-Scraper-Secret on API→scraper calls)
# SCRAPER_SERVICE_SECRET=
PORT=8080
# Set to "disabled" when using external cron (e.g. Render free tier)
SCRAPE_CRON_SPEC=0 */4 * * *
ENRICH_CRON_SPEC=0 2 * * *
# ENRICH_BATCH_SIZE=50  # Listings per enrichment run (API; default 50)
# Cron triggers (POST /scrape-now, /enrich-now): set CRON_SECRET in production; external cron sends X-Cron-Secret (prefer header over ?secret=)
# CRON_SECRET=
# Production detection: APP_ENV=production, or RENDER=true (Render). If CRON_SECRET is unset in production, only admin Bearer works unless:
# ALLOW_OPEN_CRON=1
# CORS: comma-separated origins, or * to allow all (default)
# CORS_ORIGINS=*

# Optional: Sentry error monitoring (API + scraper use SENTRY_DSN; web uses NEXT_PUBLIC_SENTRY_DSN)
# SENTRY_DSN=https://...@...ingest.sentry.io/...
# SENTRY_ENVIRONMENT=development
# Release: on Render, RENDER_GIT_COMMIT is set automatically and is used if SENTRY_RELEASE is unset
# SENTRY_RELEASE=custom-label   # optional override (local or non-Render hosts)

# Scraper (apps/scraper) - use Render Standard (2GB) so Chromium runs locally
# Same SENTRY_* as API when monitoring the scraper (separate Sentry Node.js project recommended)
# SCRAPER_SERVICE_SECRET=   # Match API; when set, POST /scrape /enrich /scrape-debug require X-Scraper-Secret or Bearer
PORT=3000
# SCRAPE_DELAY_MS=5000
# ENRICH_DELAY_MS=5000
# SCRAPER_MAX_PAGES=5
# SCRAPER_MAX_PRODUCTS=10   # Limit products per scrape (0 = no limit; convenient for testing)
# SCREENSHOT_DIR=./logs
# DEBUG=1
# Optional: remote CDP browser (e.g. for local dev without Chromium)
# BROWSER_WS_ENDPOINT=wss://...
# BROWSERLESS_TOKEN=...

# Web (apps/web)
# NEXT_PUBLIC_API_URL=/api   # client; defaults to /api
# API_URL=http://localhost:8080   # server (dev); set to API URL in prod
#
# Sentry (browser + server): create a Next.js project in Sentry, use the same DSN for client/server
# NEXT_PUBLIC_SENTRY_DSN=https://...@...ingest.sentry.io/...
# SENTRY_ENVIRONMENT=development
# On Vercel, VERCEL_GIT_COMMIT_SHA + VERCEL_ENV are used for release/environment when vars below unset
# NEXT_PUBLIC_SENTRY_RELEASE=   # optional override (else next.config maps from SENTRY_RELEASE / VERCEL_GIT_COMMIT_SHA)
# CI / readable stack traces: SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT (see apps/web/README.md)
